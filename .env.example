# GeoMeasure API configuration.
# Copy this file to `.env` and adjust values as needed. Every value is
# optional: the defaults below are what the application uses when nothing
# is set. Never commit a real `.env` file.

APP_NAME=GeoMeasure API
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false

# Storage. Relative paths are resolved against the project root, so the API
# behaves the same no matter which directory it is started from.
UPLOAD_DIR=uploads
DB_PATH=data/geo_measure.db

# Upload / archive safety limits
MAX_UPLOAD_MB=50
MAX_EXTRACT_MB=256
MAX_ZIP_ENTRIES=1000
MAX_COMPRESSION_RATIO=500

# Decimal places used when reporting measurements (m / m2)
MEASUREMENT_DECIMALS=2
